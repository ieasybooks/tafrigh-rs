[
  {
    "name": "Tests",
    "match": ["tests/**", "crates/*/tests/**"],
    "children": [
      { "name": "Fixtures", "match": ["**/fixtures/**"] },
      { "name": "Test code", "fallback": true }
    ]
  },
  {
    "name": "Generated docs",
    "match": ["docs/cli.md", "docs/tafrigh.1", "CHANGELOG.md"]
  },
  {
    "name": "Docs",
    "match": ["**/*.md", "docs/**", ".github/**/*.md", "**/{LICENSE,NOTICE}*"]
  },
  {
    "name": "Dependencies",
    "match": ["**/Cargo.toml", "**/Cargo.lock"]
  },
  {
    "name": "Source",
    "children": [
      { "name": "CLI", "match": ["src/**"] },
      { "name": "Core", "match": ["crates/tafrigh/src/**", "crates/tafrigh/assets/**"] },
      { "name": "Wit", "match": ["crates/tafrigh-wit/src/**"] }
    ]
  },
  {
    "name": "Tooling",
    "match": [
      ".github/**",
      "scripts/**",
      "mise.toml",
      "rust-toolchain.toml",
      ".gitignore",
      "release-please-config.json",
      ".release-please-manifest.json"
    ]
  },
  { "name": "Other", "fallback": true }
]
